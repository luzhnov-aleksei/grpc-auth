# General application configuration
LOG_LEVEL=info

# gRPC configuration
GRPC_PORT=:50051
GRPC_TIMEOUT=15s

# PostgreSQL configuration
# имя сервиса в docker-compose
DB_HOST=postgres
DB_PORT=5432
DB_NAME=simple_service
DB_USER=admin
DB_PASSWORD=admin
DB_SSL_MODE=disable
DB_POOL_MAX_CONNS=10
DB_POOL_MAX_CONN_LIFETIME=300s
DB_POOL_MAX_CONN_IDLE_TIME=150s